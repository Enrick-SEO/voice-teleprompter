{
  "name": "teleprompteur",
  "version": "1.0.0",
  "description": "Téléprompteur transparent pour Mac avec défilement vocal (détection de voix)",
  "author": "Enrick Pellegrin",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . \"Ça téléprompt\" --platform=darwin --icon=assets/icon.icns --app-bundle-id=com.enrick.caprompt --app-version=1.0.0 --extend-info=assets/mac-extra.plist --out=dist --overwrite --ignore=\"^/dist\" --ignore=\"^/\\.claude\" --ignore=\"^/assets/icon\\.iconset\" --ignore=\"\\.command$\""
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "electron": "^33.4.11"
  }
}
